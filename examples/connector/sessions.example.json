{
  "id": "session-worker",
  "name": "Session worker",
  "url": "https://monitor.example.invalid",
  "ingestionKey": "REPLACE_PRIVATELY_OR_USE_AV_INGEST_KEY",
  "registrationKey": "REPLACE_WITH_A_PRIVATE_RANDOM_REGISTRATION_KEY",
  "handlers": {
    "local-codex": {
      "type": "agent-session", "provider": "codex", "executable": "codex",
      "workingDirectory": "./workspace",
      "maxTurnSeconds": 3600
    },
    "local-claude": {
      "type": "agent-session", "provider": "claude", "executable": "claude",
      "workingDirectory": "./workspace",
      "maxTurnSeconds": 3600
    },
    "local-opencode": {
      "type": "agent-session", "provider": "opencode", "executable": "opencode",
      "workingDirectory": "./workspace",
      "maxTurnSeconds": 3600
    },
    "ssh-agent": {
      "type": "agent-session", "provider": "codex", "transport": "ssh",
      "sshHost": "stage.example.invalid", "machineId": "stage-machine",
      "allowConfiguredMachines": true,
      "allowedHosts": ["stage.example.invalid", "stage-two.example.invalid"],
      "remoteShell": "posix", "reportingUrl": "https://monitor.example.invalid",
      "remoteCommand": ["dotnet", "/opt/agenticview/AgenticView.Server.dll", "--session-stdio", "/private/codex-session.json"],
      "remoteProfiles": {
        "codex": {"provider":"codex","command":["dotnet", "/opt/agenticview/AgenticView.Server.dll", "--session-stdio", "/private/codex-session.json"]},
        "claude": {"provider":"claude","command":["dotnet", "/opt/agenticview/AgenticView.Server.dll", "--session-stdio", "/private/claude-session.json"]},
        "opencode": {"provider":"opencode","command":["dotnet", "/opt/agenticview/AgenticView.Server.dll", "--session-stdio", "/private/opencode-session.json"]}
      },
      "maxTurnSeconds": 3600
    }
  }
}
